#!/usr/bin/env bash
set -e

if [ -z "$1" ]; then
	echo "Usage: run-ansible <user> [ansible-playbook args]" >&2
	exit 1
fi

ask_pass_flags=("-k")
for arg in "${@:2}"; do
	if [ "$arg" = "localhost" ]; then
		ask_pass_flags=()
		break
	fi
done

pushd "$HOME/dotfiles/" || exit
./scripts/helpers/ansible-setup
ansible-playbook -i ./ansible/inventory.yml -u "$1" ./ansible/playbooks/main.yaml "${ask_pass_flags[@]}" -K "${@:2}"
popd || exit
