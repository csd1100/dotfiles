#!/usr/bin/env bash
set -e

R='\033[31m'
Y='\033[1;33m'
NOCOLOR='\033[0m'

dots_to_cleanup=(
    "$HOME/env"
    "$HOME/bin/helpers"
    "$HOME/.grc"
    "$HOME/.zshrc"
    "$HOME/.p10k.zsh"
    "$HOME/.vimrc"
    "$HOME/.ideavimrc"
    "$HOME/.dircolors"
    "$HOME/.config/mpv"
    "$HOME/.config/kitty"
    "$HOME/.config/nvim"
    "$HOME/.config/neofetch"
    "$HOME/.config/hypr"
    "$HOME/.config/dunst"
    "$HOME/.config/eww"
    "$HOME/.config/rofi"
    "$HOME/.config/sketchybar"
    "$HOME/.config/skhd"
    "$HOME/.config/yabai"
    "$HOME/.config/Code"
    "$HOME/.config/VSCodium"
    "$HOME/Library/Application Support/Code"
    "$HOME/Library/Application Support/VSCodium"
)

ARG=$1

case "$ARG" in
    -n|--no|--dry-run)
        DRY_RUN="true"
        echo "Executing Dry Run..."
        ;;
    -h|--help)
        help=$(cat << 'EOF'
dots-cleanup [OPTIONS]

    -n | --no | --dry-run   - Do not cleanup symlinks just print what is going to be
                            cleaned up
    -h | --help             - Print help(this) message.

EOF
)
        echo "$help"
        exit 0
        ;;
    *)
        ;;
esac

remove_symlink() {
    local link=$1
    echo -e "Cleaning up $link"
    if [ -z "$DRY_RUN" ]; then
        rm "$link"
    fi
}

cleanup_directory() {
    local dir=$1
    local -a symlinks=()
    local -a real_files=()

    while IFS= read -r -d '' entry; do
        if [ -L "$entry" ]; then
            symlinks+=("$entry")
        elif [ -f "$entry" ]; then
            real_files+=("$entry")
        fi
    done < <(find "$dir" -mindepth 1 -print0)

    if [ "${#real_files[@]}" -gt 0 ]; then
        echo -e "${R}${dir} contains real (non-symlink) file(s):${NOCOLOR}"
        for file in "${real_files[@]}"; do
            echo -e "  ${file}"
        done

        if [ -n "$DRY_RUN" ]; then
            echo -e "${Y}Dry run: would ask before removing symlinks in ${dir}${NOCOLOR}"
        else
            read -r -p "Remove dangling symlinks in ${dir} and leave these files in place? (y/n) " reply
            case "$reply" in
                y|Y) ;;
                *)
                    echo -e "${Y}Skipping ${dir}${NOCOLOR}"
                    return
                    ;;
            esac
        fi
    fi

    for link in "${symlinks[@]}"; do
        remove_symlink "$link"
    done

    if [ -z "$DRY_RUN" ]; then
        find "$dir" -depth -type d -empty -delete
        if [ ! -e "$dir" ]; then
            echo -e "Removed empty directory $dir"
        fi
    elif [ "${#real_files[@]}" -eq 0 ]; then
        echo -e "Would remove empty directory $dir"
    fi
}

cleanup() {
    local -n items_to_cleanup=$1
    for item in "${items_to_cleanup[@]}"; do
        if [ -e "$item" ]; then
            if [ -L "$item" ]; then
                remove_symlink "$item"
            elif [ -d "$item" ]; then
                echo -e "${Y}${item} is a directory.${NOCOLOR}"
                cleanup_directory "$item"
            else
                echo -e "${Y}${item} is neither directory nor symlink.${NOCOLOR}"
            fi
        fi
    done
}

cleanup dots_to_cleanup
